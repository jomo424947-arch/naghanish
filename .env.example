# ==============================================================================
# NAGHANISH PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# انسخ هذا الملف باسم .env وقم بتعديل القيم الحساسة مثل كلمات المرور والمفاتيح
# ==============================================================================

# 1. إعدادات قاعدة البيانات (PostgreSQL 16)
POSTGRES_USER=naghanish_admin
POSTGRES_PASSWORD=ChangeThisToAStrongSecretPassword123!
POSTGRES_DB=naghanish_db
POSTGRES_PORT=5432

# رابط الاتصال لقاعدة البيانات داخل شبكة الدوكر
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# 2. إعدادات Redis (للكاش والغرف التفاعلية والويبسوكيت)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# 3. إعدادات الأمان والتشفير (JWT & Security)
# أنشئ مفتاح عشوائي طويل (مثل: openssl rand -hex 32)
SECRET_KEY=generate_a_very_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# 4. بيئة العمل والنطاقات المسموحة (CORS)
ENVIRONMENT=production
DEBUG=False
CORS_ORIGINS=["https://naghanish.com","https://www.naghanish.com","http://localhost:3000","http://localhost"]

# 5. منافذ السيرفر الخارجية
APP_PORT=80
BACKEND_PORT=8000
