# Root .gitignore

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── Python / Backend ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
develop-eggs/
eggs/
*.egg-info/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg
MANIFEST
*.manifest
*.spec
*.cover
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.pytest_cache/
nosetests.xml
coverage.xml
*.coveragerc
.mypy_cache/
.dmypy.json
dmypy.json

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.stylelintcache
